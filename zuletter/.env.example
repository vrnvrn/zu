# ZuLetter Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# GitHub Configuration
# =============================================================================

# GitHub repository owner (default: vrnvrn)
NEXT_PUBLIC_GITHUB_OWNER=vrnvrn

# GitHub repository name (default: zu)
NEXT_PUBLIC_GITHUB_REPO=zu

# GitHub Personal Access Token (required for direct issue submission)
# Create at: https://github.com/settings/tokens
# Required scopes: repo (for creating issues)
# This token is used by /api/submit-issue to create issues on behalf of users
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Arkiv Configuration (Forum)
# =============================================================================

# Private key for the forum's signing wallet (required for Forum tab)
# Generate one at: https://arkiv.network/getting-started/typescript
# Get testnet tokens at: https://mendoza.hoodi.arkiv.network/faucet/
ARKIV_PRIVATE_KEY=0x...

# Space ID for forum messages (default: zuzone_forum)
# FORUM_SPACE_ID=zuzone_forum

# =============================================================================
# Newsletter Password Protection
# =============================================================================

# Password for accessing the February 2026 newsletter (optional)
# If not set, the page will be accessible without a password
NEWSLETTER_PASSWORD=your_password_here

# =============================================================================
# Optional: Override defaults
# =============================================================================

# Base URL for the site (used for absolute URLs if needed)
# NEXT_PUBLIC_BASE_URL=https://zuletter.vercel.app
