# ZuLetter Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# GitHub Configuration
# =============================================================================

# GitHub repository owner (default: vrnvrn)
NEXT_PUBLIC_GITHUB_OWNER=vrnvrn

# GitHub repository name (default: zu)
NEXT_PUBLIC_GITHUB_REPO=zu

# GitHub Personal Access Token (required for direct issue submission)
# Create at: https://github.com/settings/tokens
# Required scopes: repo (for creating issues)
# This token is used by /api/submit-issue to create issues on behalf of users
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Optional: Override defaults
# =============================================================================

# Base URL for the site (used for absolute URLs if needed)
# NEXT_PUBLIC_BASE_URL=https://zuletter.vercel.app
